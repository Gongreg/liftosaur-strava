# Liftosaur → Settings → API Keys (premium). Starts with lftsk_
LIFTOSAUR_API_KEY=

# https://www.strava.com/settings/api (set "Authorization Callback Domain" to localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Your time zone. Needed in Docker (unraid/run.sh), which runs on UTC; elsewhere the system's is used
# TZ=Europe/Vilnius

# Optional
# LOOKBACK_DAYS=7          # how far back a plain `sync` looks for workouts
# INCLUDE_WARMUPS=false    # also send warmup sets to Strava (they count towards volume)
# INCLUDE_NOTES=false      # put Liftosaur workout notes into the Strava description
